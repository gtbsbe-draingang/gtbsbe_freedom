# Copy to backend/.env (git-ignored) and fill in. Placeholders only: never commit real values.
# An empty value means "not set".

# Claude API key. Without it the app starts, evaluations that need a new model call return 409.
ANTHROPIC_API_KEY=
# The organisers' data URL (a signed URL; `group_id` is replaced, nothing else). Never commit it.
ORGANIZER_API_URL=
# JSON list of allowed browser origins. `*` stands for one DNS label fragment, e.g.
# ["https://*.crm*.dynamics.com"] allows https://org1.crm4.dynamics.com.
CORS_ORIGINS=[]
# JSON list of sources allowed to frame our pages (CSP frame-ancestors), e.g.
# ["'self'", "https://*.crm4.dynamics.com"].
FRAME_ANCESTORS=["'self'"]
